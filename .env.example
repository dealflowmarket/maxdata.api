# Server
PORT=3000

# Backend selector
# Use "postgres" for the new Phase 1 Supabase/Postgres path.
# Use "mongo" only if you want the legacy Mongo-backed API behavior.
DATA_BACKEND=postgres

# Postgres / Supabase
# Prefer the Supabase pooled connection string here.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Optional alias if you prefer naming it explicitly for Supabase.
# The API and pipeline accept either DATABASE_URL or SUPABASE_DB_URL.
SUPABASE_DB_URL=

# Postgres connection tuning
PGSSLMODE=require
PG_POOL_MAX=10

# Legacy Mongo fallback
MONGODB_URI=mongodb://user:password@72.60.40.91:27017/maxdata?authSource=admin
